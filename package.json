{
  "name": "universal-dns-hub",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "🌐 多云域名管理系统 - 统一管理 Cloudflare、阿里云、腾讯云等 DNS 服务商",
  "author": "Universal DNS Hub Team",
  "homepage": "https://github.com/your-username/universal-dns-hub#readme",
  "repository": {
    "type": "git",
