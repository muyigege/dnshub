# ============================================================
# Universal DNS Hub 环境变量示例
# ============================================================
# 数据库：文件型 SQLite，无需配置连接字符串
# 文件自动创建于 data/local.sqlite，schema 自动迁移（幂等）
# 因此本文件不存在 DATABASE_URL

# Encryption Key (用于 AES-256-GCM 加密 DNS 服务商凭证)
# 必须为 32 字节（64 位十六进制）。生成命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-character-encryption-key-here-replace-me

# AI Configuration (可选 —— 也可在 Web UI 的「AI 配置」页面设置)
# AI API URL 必须是完整端点，以 /v1/chat/completions 结尾
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL_ID=gpt-4
AI_API_KEY=your-ai-api-key

# Application Configuration
NEXT_PUBLIC_APP_NAME=Universal DNS Hub
NEXT_PUBLIC_APP_URL=http://localhost:5000

# Development Mode
NODE_ENV=development
